# Chạy dashboard nền cho người dùng hiện tại.
# Cài:  cp trcc-dashboard.service ~/.config/systemd/user/
#       systemctl --user daemon-reload
#       systemctl --user enable --now trcc-dashboard
# Log:  journalctl --user -u trcc-dashboard -f
[Unit]
Description=Dashboard cho Thermalright Trofeo Vision 9.16 LCD
After=network-online.target graphical-session.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/TROFEO-VISION-9.16-LCD-WHITE/dashboard
ExecStart=/usr/bin/python3 -m lcd_dashboard -c %h/.config/trcc-dashboard/config.toml -v
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
